PASTA_LIST_IMAGE=registry.example.com/your-org/pasta-list:2026.09.20
PASTA_LIST_CONNECTION_STRING=Host=pastalist-db;Port=5432;Database=pastalist;Username=pastalist;Password=replace-me
PASTA_LIST_CODE_HASH_KEY=replace-with-a-long-random-secret (openssl rand -base64 48)
PASTA_LIST_SMTP_HOST=smtp.example.com
PASTA_LIST_SMTP_PORT=587
PASTA_LIST_SMTP_USER=replace-me
PASTA_LIST_SMTP_PASSWORD=replace-me
PASTA_LIST_SMTP_FROM=auth@pasta-list.de
