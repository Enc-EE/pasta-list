{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/api/PastaList.Api/PastaList.Api.csproj"
        },
        {
            "name": "Web (Brave)",
            "type": "chrome",
